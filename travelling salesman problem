#include <iostream>
#include <climits>
#include <algorithm>
using namespace std;

const int N = 4;
int cost[N][N] = {
    {0, 10, 15, 20},
    {10, 0, 35, 25},
    {15, 35, 0, 30},
    {20, 25, 30, 0}
};

int tsp(int mask, int pos) {
    if (mask == (1 << N) - 1)
        return cost[pos][0];

    int ans = INT_MAX;

    for (int city = 0; city < N; city++) {
        if (!(mask & (1 << city))) {
            int newAns = cost[pos][city] +
                         tsp(mask | (1 << city), city);
            ans = min(ans, newAns);
        }
    }
    return ans;
}

int main() {
    cout << "Minimum travelling cost: "
         << tsp(1, 0) << endl;
    return 0;
}
